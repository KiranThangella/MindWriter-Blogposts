# Sanity Configuration
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Backend API (Cloudflare Worker) base URL — no trailing slash.
# Required for all /api/* calls to reach the backend instead of falling
# back to this site's own origin (which has no /api routes and would
# return the SPA's index.html instead of JSON).
VITE_API_BASE_URL=https://api.mindwriter.in

# AI Model Keys (Server-side secrets)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Affiliate CTA — auto-shown at the end of every article (components/AffiliateCTA.tsx).
# Leave VITE_AFFILIATE_URL blank to show nothing (safe default before you've
# picked an offer). One offer, site-wide, for now.
VITE_AFFILIATE_URL=
VITE_AFFILIATE_EYEBROW=Recommended
VITE_AFFILIATE_TITLE=
VITE_AFFILIATE_DESCRIPTION=
VITE_AFFILIATE_BUTTON_TEXT=Learn more
